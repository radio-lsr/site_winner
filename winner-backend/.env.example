# ============================================================
# WINNER Backend — exemple de configuration
# Copiez ce fichier vers `.env` puis remplissez les valeurs :
#   cp .env.example .env
# ============================================================

# Port du serveur Express
PORT=5000

# --- Moteur de base de données ---
# Laissez vide (ou "mysql") pour MySQL/MariaDB.
# Mettez "sqlite" pour développer SANS installer de serveur MySQL :
# la base est un simple fichier winner.db créé automatiquement.
DB_ENGINE=sqlite

# --- Base de données MySQL (inutile si DB_ENGINE=sqlite) ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=VOTRE_MOT_DE_PASSE_MYSQL
DB_NAME=winner_db

# --- Chemin du fichier SQLite (optionnel, défaut : winner-backend/winner.db) ---
# DB_SQLITE_PATH=./winner.db

# --- Sécurité JWT ---
# Générez un secret fort avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REMPLACEZ_PAR_UN_SECRET_LONG_ET_ALEATOIRE

# --- Environnement (development | production) ---
NODE_ENV=development

# --- Compte admin créé par `npm run db:seed` (optionnel) ---
ADMIN_EMAIL=admin@winner.local
ADMIN_PASSWORD=Admin@Winner2026

# --- URL publique du frontend (pour les liens de réinitialisation) ---
FRONTEND_URL=http://localhost:5173

# --- Envoi d'emails (optionnel — requis pour l'envoi réel du lien de
#     réinitialisation ; sans SMTP le lien est affiché dans la console) ---
# SMTP_HOST=smtp.exemple.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=compte@exemple.com
# SMTP_PASS=mot_de_passe_app
# SMTP_FROM="WINNER Multiservice <compte@exemple.com>"
