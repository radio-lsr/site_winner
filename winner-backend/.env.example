# Développement SQLite local (PowerShell) : complétez les secrets avant démarrage.
PORT=5000
DB_ENGINE=sqlite
DB_SQLITE_PATH=./winner.db
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOM=Administrateur WINNER
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Pour MySQL seulement, utiliser un compte dédié à winner_db (jamais root).
# DB_ENGINE=mysql
# DB_HOST=localhost
# DB_USER=winner_app
# DB_PASSWORD=
# DB_NAME=winner_db

# Notification facultative; sans SMTP, aucune réinitialisation email n'est possible.
CONTACT_EMAIL=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
