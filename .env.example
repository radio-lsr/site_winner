# Configuration Docker : copier vers .env et remplacer les valeurs avant le déploiement.
# Ne jamais commiter .env.
MYSQL_ROOT_PASSWORD=
# MYSQL_PASSWORD doit être hexadécimal (openssl rand -hex 32).
MYSQL_PASSWORD=
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
FRONTEND_URL=http://localhost:8080
COOKIE_SECURE=false
# Compose local = nginx interne (1 proxy). VPS derrière nginx hôte + nginx Docker = 2.
TRUST_PROXY=1

# Facultatif (notification email du formulaire de contact / reset password)
CONTACT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Origines autorisées pour l'API; adapter au domaine en production.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
