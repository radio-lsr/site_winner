# À copier vers .env à la racine puis à remplir avec des secrets uniques.
# Ne jamais commiter le fichier .env.
MYSQL_ROOT_PASSWORD=
# Générer aussi MYSQL_PASSWORD en hexadécimal (node crypto.randomBytes(32)).
MYSQL_PASSWORD=
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
FRONTEND_URL=http://localhost:8080
COOKIE_SECURE=false

# Facultatif (notification email du formulaire de contact)
CONTACT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Origines autorisées pour l'API (séparées par des virgules); adapter au domaine public.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
